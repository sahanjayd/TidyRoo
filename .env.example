# ─── Node.js Server ───────────────────────────────────────────────────────────
PORT=3000

# URL of the Python FastAPI backend
BACKEND_URL=http://localhost:8000

# ─── Python Backend ────────────────────────────────────────────────────────────
# Outbound email (SMTP) — used by the contact, callback, and booking forms
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Recipient email address for form submissions
CONTACT_RECIPIENT=info@tidyroo.au

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Used by the reviews API (optional — SQLite is used as the default fallback)
DATABASE_URL=postgresql://user:password@localhost:5432/tidyroo

# ─── Reviews admin ─────────────────────────────────────────────────────────────
# Bearer token for the /api/reviews/admin endpoints
REVIEW_ADMIN_TOKEN=change-me-to-a-secure-random-string

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (leave blank to allow all in dev)
ALLOWED_ORIGINS=http://localhost:3000
