# ─── Outbound email (SMTP) ─────────────────────────────────────────────────────
# Used for contact forms, booking requests, and newsletter signups.
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Address that receives all form submission emails
CONTACT_RECIPIENT=info@tidyroo.au

# ─── Reviews admin ─────────────────────────────────────────────────────────────
# Bearer token to protect POST /api/reviews/admin (approve/reject)
# Generate with: openssl rand -hex 32
REVIEW_ADMIN_TOKEN=change-me-to-a-secure-random-string
